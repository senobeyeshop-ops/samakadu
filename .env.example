# À saisir dans Netlify > Site configuration > Environment variables. Ne jamais committer de vraies valeurs.

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://VOTRE-REF.supabase.co
SUPABASE_ANON_KEY=
# Clé SECRÈTE de service : sert uniquement à valider les paiements côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Coach IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Wave Business en direct — FACULTATIF : sans ces clés, Wave passe par PayTech
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Seulement si « Request signing » est activé sur la clé API
WAVE_SIGNING_SECRET=

# PayTech (paytech.sn > Paramètres > API) : encaisse Wave et Orange Money
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# test (débit symbolique de 100 à 150 FCFA) ou prod (compte activé par PayTech)
PAYTECH_ENV=test

# Optionnel : domaines supplémentaires autorisés, séparés par des virgules
ALLOWED_ORIGINS=
